FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV DISPLAY=:99

# Install all dependencies in one layer
RUN apt-get update && apt-get install -y \
    wget \
    xvfb \
    libgtk-3-0 \
    libglib2.0-0 \
    libgdk-pixbuf2.0-0 \
    libdbus-1-3 \
    libgl1 \
    libglu1-mesa \
    libwebkit2gtk-4.1-0 \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    libgstreamer-plugins-bad1.0-0 \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    libgstreamer-gl1.0-0 \
    libnice10 \
    libva2 \
    libva-drm2 \
    libxkbcommon-x11-0 \
    xdg-dbus-proxy \
    && rm -rf /var/lib/apt/lists/*

# Download and extract PrusaSlicer
RUN wget -q https://github.com/prusa3d/PrusaSlicer/releases/latest/download/PrusaSlicer-*.AppImage \
      -O /tmp/prusaslicer.AppImage && \
    chmod +x /tmp/prusaslicer.AppImage && \
    /tmp/prusaslicer.AppImage --appimage-extract && \
    mv squashfs-root /opt/prusaslicer && \
    rm /tmp/prusaslicer.AppImage

# Entrypoint script that starts Xvfb and runs PrusaSlicer
RUN echo '#!/bin/bash\n\
Xvfb :99 -screen 0 1024x768x24 &\n\
sleep 1\n\
exec /opt/prusaslicer/usr/bin/prusa-slicer "$@"' > /usr/local/bin/prusaslicer && \
    chmod +x /usr/local/bin/prusaslicer

WORKDIR /data
