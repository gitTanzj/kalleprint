# Server
PUBLIC_HOST=http://127.0.0.1
PORT=8080

# Database
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kalleprint

# Miscallenous
UPLOAD_PATH="kalleprint/uploads/printables"
STORAGE_DIR="/kalleprint/storage"

# PrusaSlicer (set automatically in Docker via PRUSA_SLICER_PATH env)
PRUSA_SLICER_PATH=prusa-slicer
# Optional: override the embedded Creality K1 printer/print profiles
# PRUSA_PRINTER_PROFILE=/path/to/printer.ini
# PRUSA_PRINT_PROFILE=/path/to/print.ini

# Http address of your 3D printer
PRINTER_ADDRESS="http://192.168.0.2"
