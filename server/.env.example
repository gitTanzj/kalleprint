# Server
PUBLIC_HOST=http://127.0.0.1
PORT=8080

# Database
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kalleprint

# Miscallenous
UPLOAD_PATH="kalleprint/uploads/printables"

# PrusaSlicer (set automatically in Docker via PRUSA_SLICER_PATH env)
PRUSA_SLICER_PATH=prusa-slicer
PRUSA_SLICER_CONFIG=/kalleprint/config/prusa-slicer.ini
